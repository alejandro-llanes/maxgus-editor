// maxgus configuration.
//
// Copy this to ~/.config/maxgus/config.kdl and edit it. Every node is
// optional; anything left out keeps its default. A node maxgus does not
// recognise is reported with a line number and skipped, so a file written
// for a newer version still starts an older one.
//
// Every option, with its type and default:  docs/configuration-reference.md
// Whole themes ready to copy:               docs/themes/

// ---- settings ----
set tab-width=4 indent-with-tabs=#false
set theme="maxgus-dark"          // maxgus-dark, maxgus-light, maxgus-term
set line-numbers=#true
set scroll-margin=3              // lines of context kept around point
set truncate-lines=#true         // clip long lines instead of wrapping
set fill-column=80
set fill-column-indicator=#false  // draw a line at the fill column
set require-final-newline=#true
set delete-trailing-whitespace=#true
set backup-files=#false          // write file~ before overwriting
set syntax-highlighting=#true
set grammar-auto-install=#true   // when a file's language has no grammar,
                                 // offer to fetch and build one. Nothing is
                                 // cloned, compiled or loaded until you say
                                 // yes; M-x install-grammar asks for one by
                                 // name whatever this says.
set lsp-enabled=#true
set lsp-doc=#true                // a box beside the symbol under the cursor,
                                 // once it has rested there; lsp-ui-doc

// Suggestions while typing, from the language server. `C-M-i` asks for
// them whatever this says; `C-n`/`C-p` move, `RET` or `TAB` takes one,
// `C-g` puts them away.
set autocomplete=#true
set autocomplete-min-chars=2     // letters typed before a list is offered

// After a pause in the middle of `C-x` or `C-c`, a panel says what the
// next key can be — which is how the leader is meant to be learned.
set which-key=#true
set which-key-delay-ms=400
set idle-delay-ms=150            // pause before re-highlighting and syncing
set case-fold-search=#null       // #null is smart case; #true or #false force it
set kill-ring-max=60             // how many kills C-y and M-y can reach
set blink-cursor=#false          // ask the terminal for a blinking block
set echo-keystrokes-ms=1000      // pause before a half-typed C-x is echoed
set nerd-font-icons=#true        // glyphs in the tree and mode line
set session=#false               // reopen what was open, when started with
                                 // no file named

// A light beside the cursor after it jumps, so the eye finds it again.
// `beacon` for Emacs, with its settings under their own names.
set beacon=#false
set beacon-size=40                       // cells the light covers
set beacon-blink-delay-ms=300            // how long before it fades
set beacon-blink-duration-ms=300         // how long the fade takes
set beacon-color="0.5"                   // a grade against the background,
                                         // or a colour like "#ff0066"
set beacon-blink-when-buffer-changes=#true
set beacon-blink-when-window-scrolls=#true
set beacon-blink-when-window-changes=#true
set beacon-blink-when-point-moves-vertically=0   // 0 is never

// The side panel is a column of three windows. Any of them can be
// switched off; the symbol outline additionally hides itself when there
// is no language server running to ask for one.
set panel-tree=#true             // the file tree
set panel-symbols=#true          // the symbols in the buffer being edited
set panel-buffers=#true          // the list of open buffers
set panel-at-startup=#false      // open it as soon as the editor starts
set panel-symbols-height=12      // rows of its window; the tree takes the rest
set panel-buffers-height=8

// The terminal panel along the bottom. Unset, tabs start whatever
// `$SHELL` says, which is a choice the user has already made once.
set shell="/bin/bash"

// The window, which a `full` build opens unless it is started with `-nw`.
// The terminal front end ignores both: what a terminal draws with is
// whatever the terminal is configured to use.
set gui-font="JetBrainsMono Nerd Font"
set gui-font-size=16
// Pixels between one line and the next, over what the font asks for, and
// pixels of margin inside the window's edge.
set gui-line-spacing=0
set gui-padding=0
// A thin bar at a window's edge while it scrolls, saying where it is.
set gui-scroll-indicator=#true
// What the language server says about a symbol is set in a reading face.
set gui-prose-font="sans-serif"

// The wheel, in a window. A window can draw a fraction of a line, so a
// notch slides rather than jumping; these are how far it goes and how
// long it takes. `smooth-scroll-ms=0` turns the slide off. A touchpad
// reports the pixels it moved and ignores `mouse-wheel-lines`.
set mouse-wheel-lines=3
set smooth-scroll-ms=300

// And the same slide for the view a command moves: `C-v`, a search that
// lands off the screen, `M->`. A long jump is not animated in full — that
// would be an animation to watch rather than a view to read — but the last
// few lines of it are, which is what says which way it went. `0` turns it
// off.
set scroll-animation-far-lines=1

// The cursor slides to where point went instead of appearing there, and
// smears while it travels so the eye can follow it. `cursor-animation-ms=0`
// turns it off; `cursor-trail` is how far the back of the block lags the
// front, in percent. The window draws this instead of the beacon, which is
// the same job done twice.
set cursor-animation-ms=150
set cursor-short-animation-ms=40
set cursor-trail=70

// And what it leaves behind it, which is decoration and is off unless
// asked for. `sonicboom`, `ripple` and `wireframe` mark where it landed;
// `railgun`, `torpedo` and `pixiedust` trail particles along the way it
// came. An empty name is none of them.
set cursor-vfx=""
set cursor-vfx-opacity=78                 // percent, at its strongest
set cursor-vfx-particle-lifetime-ms=500   // how long a trailing particle lives
set cursor-vfx-highlight-lifetime-ms=200  // how long a mark takes to fade
set cursor-vfx-particle-density=70        // percent: particles per cell travelled
set cursor-vfx-particle-speed=10          // how fast they fly away
set cursor-vfx-particle-phase=150         // percent: how far round a railgun's arc
set cursor-vfx-particle-curl=100          // percent: how sharply a flight turns

// Let the font join characters it was made to draw as one — `!=` as a
// single glyph. A font without such joins is unaffected.
set ligatures=#true

// What is behind a popup — the completion list, the doc box, the which-key
// panel — is blurred, and the popup sits on it short of solid so it shows
// through. Costs nothing while nothing is open.
set floating-blur=#true
set floating-blur-radius=8   // pixels
set floating-opacity=82      // percent; never below 20, or it cannot be read

// ---- key bindings ----
//
// The command names are the ones M-x offers and C-h b lists.
keymap "global" {
    bind "C-c f" "lsp-format-buffer"
    bind "C-c d" "lsp-describe-thing-at-point"
    bind "M-o"   "other-window"

    // Take a binding away entirely.
    unbind "C-z"
}

// A block named after a major mode becomes a mode-local map.
keymap "rust-mode" {
    bind "C-c C-c" "lsp-code-action"
}

// The file tree is a mode too. These add to the treemacs bindings rather
// than replacing them.
keymap "treefile-mode" {
    bind "C-c C-r" "treefile-refresh"
}

// ---- faces ----
//
// Only the differences from the built-in theme need stating. A whole theme is
// better kept as its own file in ~/.config/maxgus/themes/ — everything there
// is loaded at startup and `set theme=` finds it by name.
theme "maxgus-dark" {
    face "font-lock-comment"  fg="#5f6b73" italic=#true
    face "font-lock-string"   fg="#98c379"
    face "region"             bg="#3a4048"
    face "line-number"        fg="#4b5263"

    // `fg` and `bg` are the short spellings; `foreground` and `background`
    // mean the same thing.
    face "font-lock-keyword"  foreground="#c678dd" bold=#true
    face "lazy-highlight"     background="#4b3a2f"

    // The rest of the attributes a terminal can show. Any the terminal does
    // not understand it simply ignores.
    face "font-lock-type"     underline=#true
    face "shadow"             dim=#true
    face "diagnostic-error"   fg="#e06c75" strikethrough=#false
    face "cursor"             reverse=#true

    // `inherit` copies whatever the named face sets.
    face "diagnostic-warning" inherit="warning" underline=#true
}

// ---- grammars ----
//
// Eleven are compiled in: c, html, ini, javascript, json, markdown, python,
// rust, toml, xml and yaml. Any other — kdl and rhai among them — can be
// coloured by a grammar already installed on
// the system, but only if this says where to look — loading one means
// loading a shared library, so it never happens by default.
//
// Per-platform instructions, and what you are trusting: docs/grammars.md
// `M-x describe-grammars` says what loaded and what did not.
grammars {
    search "/usr/lib"                            // libtree-sitter-<lang>.so
    queries "/usr/share/tree-sitter/queries"     // <lang>/highlights.scm
    queries "/usr/share/nvim/runtime/queries"
}

// One that is not where those would look.
grammar "zig" library="/home/me/grammars/libtree-sitter-zig.so" \
              queries="/home/me/grammars/zig/highlights.scm"

// ---- language servers ----
lsp "rust" command="rust-analyzer" {
    root-markers "Cargo.toml"
}

lsp "python" command="pyright-langserver" args="--stdio" {
    root-markers "pyproject.toml" "setup.py"
}

// One argument fits on the `args=` property; several go in an `args` node.
lsp "typescript" command="typescript-language-server" {
    args "--stdio" "--log-level" "2"
    root-markers "tsconfig.json" "package.json"
}

lsp "go" command="gopls" {
    root-markers "go.mod"
}

// ---- the file tree ----
tree {
    width 32
    show-hidden #false
    directories-first #true
    git-status #true
    follow #true                 // keep the tree on the file being edited
    ignore ".git" "target" "node_modules" "__pycache__"
}
