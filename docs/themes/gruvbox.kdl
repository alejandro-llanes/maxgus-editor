// Gruvbox — warm, retro, low contrast.
// Palette after Pavel Pertsev's original.
//
// Drop into ~/.config/maxgus/themes/ and:
//
//   set theme="gruvbox"

theme "gruvbox" base="maxgus-dark" {
    face "default"                   fg="#ebdbb2" bg="#282828"
    face "cursor"                    bg="#ebdbb2"
    face "region"                    bg="#504945"
    face "highlight"                 bg="#3c3836"
    face "shadow"                    fg="#928374"

    face "line-number"               fg="#7c6f64"
    face "line-number-current-line"  fg="#fabd2f" bold=#true
    face "fill-column-indicator"     fg="#3c3836"
    face "trailing-whitespace"       bg="#cc241d"

    face "mode-line"                 fg="#282828" bg="#a89984"
    face "mode-line-inactive"        fg="#a89984" bg="#3c3836"
    face "mode-line-buffer-id"       fg="#282828" bold=#true
    face "minibuffer-prompt"         fg="#83a598" bold=#true
    face "echo-area"                 fg="#ebdbb2"

    face "isearch"                   fg="#282828" bg="#fabd2f"
    face "lazy-highlight"            fg="#282828" bg="#d79921"
    face "isearch-fail"              fg="#fbf1c7" bg="#cc241d"
    face "match-paren"               fg="#fe8019" bold=#true

    face "completion-selected"       fg="#282828" bg="#83a598"
    face "completion-annotation"     fg="#928374" italic=#true
    face "completion-border"         fg="#504945"
    face "completion-key"            fg="#8ec07c"
    face "completion-count"          fg="#fe8019" bold=#true

    face "error"                     fg="#fb4934" bold=#true
    face "warning"                   fg="#fabd2f"
    face "success"                   fg="#b8bb26"

    face "font-lock-keyword"         fg="#fb4934"
    face "font-lock-builtin"         fg="#fe8019"
    face "font-lock-constant"        fg="#d3869b"
    face "font-lock-string"          fg="#b8bb26"
    face "font-lock-comment"         fg="#928374" italic=#true
    face "font-lock-doc"             fg="#a89984" italic=#true
    face "font-lock-function-name"   fg="#b8bb26" bold=#true
    face "font-lock-variable-name"   fg="#83a598"
    face "font-lock-type"            fg="#fabd2f"
    face "font-lock-property"        fg="#8ec07c"
    face "font-lock-number"          fg="#d3869b"
    face "font-lock-operator"        fg="#ebdbb2"
    face "font-lock-punctuation"     fg="#a89984"
    face "font-lock-preprocessor"    fg="#8ec07c"
    face "font-lock-escape"          fg="#fe8019"
    face "font-lock-label"           fg="#83a598"
    face "font-lock-attribute"       fg="#d3869b" italic=#true

    face "diagnostic-error"          fg="#fb4934" undercurl=#true
    face "diagnostic-warning"        fg="#fabd2f" undercurl=#true
    face "diagnostic-info"           fg="#83a598"
    face "diagnostic-hint"           fg="#8ec07c"

    face "tree-root"                 fg="#fabd2f" bold=#true
    face "tree-directory"            fg="#83a598"
    face "tree-file"                 fg="#ebdbb2"
    face "tree-symlink"              fg="#8ec07c" italic=#true
    face "tree-selected"             bg="#504945"
    face "tree-arrow"                fg="#928374"
    face "tree-git-modified"         fg="#fabd2f"
    face "tree-git-added"            fg="#b8bb26"
    face "tree-git-deleted"          fg="#fb4934"
    face "tree-git-untracked"        fg="#8ec07c"
    face "tree-git-ignored"          fg="#665c54"
    face "tree-git-conflict"         fg="#fe8019" bold=#true
}
