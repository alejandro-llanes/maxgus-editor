// The configuration the screenshots of the window are taken under.
//
// `scripts/screenshots-gui.sh` starts the editor with this rather than with
// whoever is taking them's own configuration, so a picture shows the editor
// as it ships instead of as one person has bent it, and so the pictures do
// not change when that person changes their theme.
//
// It is the defaults, with these differences:
//
//   - line numbers on, and long lines wrapped rather than cut off, so a
//     picture of code reads as code usually does in one.
//   - the beacon on, for the take that shows it.
//   - the language server off. Nothing in most takes asks it anything, and a
//     server that is missing or that exits writes a red line across the echo
//     area that would be in every one of them; the two that need clangd
//     turn it back on.
//   - no question about grammars, and a plain shell — both below.

set theme="maxgus-dark"
set line-numbers=#true
set truncate-lines=#false
set syntax-highlighting=#true
set grammar-auto-install=#false   // no network, and no question mid-take

set lsp-enabled=#false
set session=#false
set backup-files=#false

set which-key=#true
set beacon=#true
// The light fades in a few hundred milliseconds and its default is to fire
// only when the window scrolls, so a still of a jump usually catches
// nothing. These make it fire on a jump and linger long enough to be
// photographed; they change when it shows, not what it is.
set beacon-blink-when-point-moves-vertically=4
set beacon-blink-duration-ms=1400
set beacon-blink-delay-ms=500

set ligatures=#true
set floating-blur=#true

// A plain shell, so the terminal picture has a neutral prompt rather than
// whatever the person recording has configured, with their hostname in it.
set shell="/bin/sh"

set panel-tree=#true
set panel-symbols=#true
set panel-buffers=#true
